<%- include('../partials/header') %>
<h1 class="h3">Login</h1>
<% errors.forEach(e => { %><div class="alert alert-danger"><%= e %></div><% }) %>
<form method="POST" action="/login" class="col-md-5">
  <label for="email" class="form-label">Email</label>
  <input id="email" name="email" type="email" class="form-control mb-3" value="<%= form.email || '' %>">
  <label for="password" class="form-label">Password</label>
  <input id="password" name="password" type="password" class="form-control mb-3">
  <button class="btn btn-primary">Login</button>
  <a href="/register" class="ms-2">Create account</a>
</form>
<%- include('../partials/footer') %>