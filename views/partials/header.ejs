<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Equipment Borrowing System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-dark bg-dark px-3">
  <a class="navbar-brand" href="/">Equipment Borrowing</a>
  <% if (user) { %>
    <div class="d-flex gap-3 align-items-center text-white">
      <a class="text-white" href="/equipment">Equipment</a>
      <% if (['student','faculty'].includes(user.role)) { %><a class="text-white" href="/requests/mine">My Requests</a><% } %>
      <% if (['custodian','admin'].includes(user.role)) { %><a class="text-white" href="/manage/requests">Manage</a><% } %>
      <% if (user.role === 'admin') { %><a class="text-white" href="/admin/users">Users</a><a class="text-white" href="/admin/reports">Reports</a><% } %>
      <span><%= user.name %> (<%= user.role %>)</span>
      <form method="POST" action="/logout" class="m-0"><button class="btn btn-sm btn-outline-light">Logout</button></form>
    </div>
  <% } %>
</nav>
<main class="container py-4">
<% if (flash) { %><div class="alert alert-success"><%= flash %></div><% } %>